# School Management System - Environment Configuration Example
# Copy this file to .env and update with your actual values

# Flask secret key for session management
# Generate a secure key using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secure-secret-key-here-change-this

# Master activation password for subscription activation
# This is the password users will need to activate their subscription plans
MASTER_ACTIVATION_PASSWORD=your-master-activation-password-here
